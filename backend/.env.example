# =====================================================
# MY VAL BACKEND - Environment Variables
# =====================================================
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Paystack (Test Keys)
PAYSTACK_SECRET_KEY=sk_test_d85d3a5d04f98db75a199fffbabfb8559b123352
PAYSTACK_PUBLIC_KEY=pk_test_9c369555960d671de6bf186a73eb6b594df2f357

# Firebase Admin SDK
# Download your service account key from Firebase Console:
# Project Settings > Service Accounts > Generate New Private Key
# Save it as serviceAccountKey.json in the backend folder
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Frontend URL (for CORS)
FRONTEND_URL=https://myval-b9f7e.web.app

# Payment Amount (in kobo - 200000 = ₦2,000)
PAYMENT_AMOUNT=200000
